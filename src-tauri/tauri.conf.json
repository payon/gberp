{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "종합여행사 ERP",
  "version": "0.1.0",
  "identifier": "com.globe.travelerp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "종합여행사 ERP",
        "width": 420,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 24 },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}